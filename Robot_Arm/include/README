/**
 * @file arm_control.h
 * @brief 6-DOF Robotic Arm Control Library Header
 */

#ifndef ARM_CONTROL_H
#define ARM_CONTROL_H

#include <Arduino.h>
#include <Servo.h>

extern Servo base, arm1, arm2, arm3, wrist, claw;

extern const int baseMin,  baseMax;
extern const int arm1Min,  arm1Max;
extern const int arm2Min,  arm2Max;
extern const int arm3Min,  arm3Max;
extern const int wristMin, wristMax;
extern const int clawMin,  clawMax;

extern int  DSD;
extern bool mode;
extern int  moveStep;

struct MoveCmd {
  char cmd;
  int  pos;
  int  dsd;
};

void armDataCommand(char serialCommand);
void armHandleCommand(char serialCommand);
void servoCommand(char serialCommand, int servoData, int DSD);
void reportStatus();
void armIniPos();
void grabObject();

#endif
